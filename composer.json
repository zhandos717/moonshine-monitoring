{
  "name": "zhandos717/moonshine-monitoring",
  "description": "Server monitoring for MoonShine with real-time resource usage tracking",
  "keywords": [
    "moonshine",
    "monitoring",
    "server",
    "cpu",
    "memory",
    "disk"
  ],
  "type": "library",
  "license": "MIT",
  "version": "1.1.3",
  "autoload": {
    "psr-4": {
      "Zhandos717\\MoonshineMonitoring\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Zhandos717\\MoonshineMonitoring\\Tests\\": "tests/",
      "Zhandos717\\MoonshineMonitoring\\Database\\Factories\\": "src/Database/Factories/"
    }
  },
  "authors": [
    {
      "name": "Zhandos",
      "email": "zhandos.zhandarbekov@gmail.com",
      "role": "Developer"
    }
  ],
  "minimum-stability": "dev",
  "require": {
    "php": "^8.1",
    "moonshine/moonshine": "^3.0",
    "moonshine/apexcharts": "dev-master"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0",
    "orchestra/testbench": "^8.0"
  },
  "extra": {
    "laravel": {
      "providers": [
        "Zhandos717\\MoonshineMonitoring\\MonitoringServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "phpunit",
    "test-coverage": "phpunit --coverage-html coverage",
    "post-install-cmd": [
      "@php artisan vendor:publish --tag=moonshine-monitoring-assets --ansi"
    ],
    "post-update-cmd": [
      "@php artisan vendor:publish --tag=moonshine-monitoring-assets --ansi"
    ]
  }
}
