{
  "name": "zhandos717/moonshine-monitoring",
  "description": "Server monitoring for MoonShine",
  "keywords": [
    "moonshine",
    "monitoring",
    "viewer"
  ],
  "type": "library",
  "license": "MIT",
  "version": "1.1.0",
  "autoload": {
    "psr-4": {
      "Zhandos717\\MoonshineMonitoring\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Zhandos717\\MoonshineMonitoring\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "Zhandos",
      "email": "zhandos.zhandarbekov@gmail.com",
      "role": "Developer"
    }
  ],
  "minimum-stability": "dev",
  "require": {
    "php": "^8.1",
    "moonshine/moonshine": "^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0",
    "orchestra/testbench": "^8.0"
  },
  "extra": {
    "laravel": {
      "providers": [
        "Zhandos717\\MoonshineMonitoring\\MonitoringServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "phpunit",
    "test-coverage": "phpunit --coverage-html coverage"
  }
}