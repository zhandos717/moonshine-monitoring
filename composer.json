{
  "name": "zhandos717/moonshine-monitoring",
  "description": "Server monitoring for MoonShine with real-time resource usage tracking",
  "keywords": [
    "moonshine",
    "monitoring",
    "server",
    "cpu",
    "memory",
    "disk",
    "moonshine-4",
    "laravel",
    "admin-panel"
  ],
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Zhandos717\\MoonshineMonitoring\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Zhandos717\\MoonshineMonitoring\\Tests\\": "tests/",
      "Zhandos717\\MoonshineMonitoring\\Database\\Factories\\": "src/Database/Factories/"
    }
  },
  "authors": [
    {
      "name": "Zhandos",
      "email": "zhandos.zhandarbekov@gmail.com",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.2",
    "moonshine/moonshine": "^3.0 || ^4.0",
    "illuminate/database": "^10.0 || ^11.0 || ^12.0 || ^13.0"
  },
  "require-dev": {
    "orchestra/testbench": "^8.0 || ^9.0 || ^10.0",
    "phpunit/phpunit": "^10.5 || ^11.0"
  },
  "extra": {
    "laravel": {
      "providers": [
        "Zhandos717\\MoonshineMonitoring\\MonitoringServiceProvider"
      ]
    },
    "branch-alias": {
      "dev-master": "1.x-dev"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test-coverage": "phpunit --coverage-html coverage"
  }
}
